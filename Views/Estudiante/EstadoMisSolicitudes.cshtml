@model SolicitudesViewModel
@{
    ViewData["Title"] = "Mis solicitudes";

    static string EstadoTexto(EstadoAprobacion estado) => estado switch
    {
        EstadoAprobacion.Aprobado => "Aprobada",
        EstadoAprobacion.Rechazado => "Rechazada",
        _ => "Pendiente de revisión"
    };

    static string EstadoClase(EstadoAprobacion estado) => estado switch
    {
        EstadoAprobacion.Aprobado => "text-bg-success",
        EstadoAprobacion.Rechazado => "text-bg-danger",
        _ => "text-bg-warning"
    };
}

<section class="nexo-section">
    <div class="nexo-catalog-header mb-4">
        <div>
            <div class="nexo-eyebrow">
                <span class="nexo-eyebrow-dot"></span>
                <span>SEGUIMIENTO Y REVISIÓN</span>
            </div>
            <h1 class="nexo-section-title">Mis solicitudes</h1>
            <p class="text-muted mt-2 mb-0">
                Consulta el estado de tus eventos y proyectos enviados a aprobación.
            </p>
        </div>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="nexo-toast" role="status">
            <span class="nexo-toast-dot">✓</span>
            <span>@mensaje</span>
        </div>
    }

    @if (Model.Notificaciones.Any())
    {
        <section class="nexo-notice-section" aria-labelledby="solicitudes-notificaciones">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <div class="nexo-eyebrow mb-1">
                        <span class="nexo-eyebrow-dot"></span>
                        <span>ACTUALIZACIONES</span>
                    </div>
                    <h2 id="solicitudes-notificaciones" class="h4 fw-bold mb-0">Notificaciones recientes</h2>
                </div>
                @if (Model.Notificaciones.Any(notificacion => !notificacion.Leida))
                {
                    <form asp-controller="Eventos" asp-action="MarcarTodasLeidas" method="post" class="m-0">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn-nexo-outline">Marcar todas como leídas</button>
                    </form>
                }
            </div>
            <div class="nexo-request-list">
                @foreach (var notificacion in Model.Notificaciones)
                {
                    <article class="nexo-notice-card @(notificacion.Leida ? "is-read" : "")">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (!notificacion.Leida)
                                {
                                    <span class="badge text-bg-success">Nueva</span>
                                }
                                <strong>@notificacion.Titulo</strong>
                            </div>
                            <p class="text-muted mb-1 mt-2">@notificacion.Mensaje</p>
                            <span class="small text-muted">@notificacion.FechaCreacion.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @if (notificacion.IdEvento.HasValue)
                            {
                                <a asp-controller="Eventos" asp-action="Detalle" asp-route-id="@notificacion.IdEvento" class="btn-nexo-outline">Ver evento</a>
                            }
                            else if (notificacion.IdProyecto.HasValue)
                            {
                                <a asp-controller="Proyectos" asp-action="Detalle" asp-route-id="@notificacion.IdProyecto" class="btn-nexo-outline">Ver proyecto</a>
                            }
                            @if (!notificacion.Leida)
                            {
                                <form asp-controller="Eventos" asp-action="MarcarNotificacionLeida" asp-route-id="@notificacion.IdNotificacion" method="post" class="m-0">
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn-nexo-ghost">Entendido</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="nexo-request-section">
        <h2 class="h4 fw-bold mb-3">Estado de mis solicitudes (@Model.MisSolicitudes.Count)</h2>
        @if (!Model.MisSolicitudes.Any())
        {
            <div class="nexo-empty py-4">
                <p class="text-muted mb-3">Todavía no has enviado eventos o proyectos para aprobación.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Eventos" asp-action="Crear" class="btn-nexo-outline">Enviar evento</a>
                    <a asp-controller="Proyectos" asp-action="Crear" class="btn-nexo-primary">Enviar proyecto</a>
                </div>
            </div>
        }
        else
        {
            <div class="nexo-request-list">
                @foreach (var solicitud in Model.MisSolicitudes)
                {
                    <article class="nexo-panel nexo-request-card">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <span class="badge text-bg-light mb-2">@solicitud.Tipo</span>
                                <h3 class="h5 fw-bold mb-1">@solicitud.Nombre</h3>
                                <p class="text-muted small mb-2">
                                    Organizador: @solicitud.Organizador · Enviada @solicitud.FechaEnvio.ToLocalTime().ToString("dd MMM yyyy · HH:mm")
                                </p>
                            </div>
                            <span class="badge rounded-pill @EstadoClase(solicitud.Estado)">@EstadoTexto(solicitud.Estado)</span>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-2 small mt-3">
                            <span class="badge rounded-pill text-bg-success">1. Solicitud enviada</span>
                            <span aria-hidden="true">→</span>
                            @if (solicitud.Estado == EstadoAprobacion.Pendiente)
                            {
                                <span class="badge rounded-pill text-bg-warning">2. Esperando revisión</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill @EstadoClase(solicitud.Estado)">
                                    2. @EstadoTexto(solicitud.Estado) · @solicitud.FechaRevision?.ToLocalTime().ToString("dd MMM yyyy · HH:mm")
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(solicitud.Comentario))
                        {
                            <div class="alert @(solicitud.Estado == EstadoAprobacion.Rechazado ? "alert-danger" : "alert-success") mt-3 mb-0">
                                <strong>Respuesta del organizador:</strong> @solicitud.Comentario
                            </div>
                        }
                        @if (solicitud.Estado == EstadoAprobacion.Aprobado)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                @if (solicitud.Tipo == "Proyecto")
                                {
                                    <a asp-controller="Proyectos" asp-action="Participacion" asp-route-id="@solicitud.Id" class="btn-nexo-primary py-1 px-3 small">
                                        ✓ Registrar participación
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Eventos" asp-action="Inscritos" asp-route-id="@solicitud.Id" class="btn-nexo-primary py-1 px-3 small">
                                        ✓ Registrar participación
                                    </a>
                                }
                                @if (solicitud.UrlDetalle is not null)
                                {
                                    <a href="@solicitud.UrlDetalle" class="btn-nexo-outline py-1 px-3 small">Ver publicación →</a>
                                }
                            </div>
                        }
                        @if (solicitud.Estado == EstadoAprobacion.Rechazado && solicitud.UrlEdicion is not null)
                        {
                            <a href="@solicitud.UrlEdicion" class="btn-nexo-outline mt-3">Editar y volver a enviar</a>
                        }
                    </article>
                }
            </div>
        }
    </section>

    @if (Model.PublicacionesInactivas.Any())
    {
        <section class="nexo-request-section">
            <h2 class="h4 fw-bold mb-3">Publicaciones eliminadas de la vista pública (@Model.PublicacionesInactivas.Count)</h2>
            <p class="text-muted">
                Estas publicaciones fueron eliminadas y ya no aparecen en el catálogo. La reactivación debe solicitarla el organizador responsable.
            </p>
            <div class="nexo-request-list">
                @foreach (var publicacion in Model.PublicacionesInactivas)
                {
                    <article class="nexo-panel nexo-request-card">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <span class="badge text-bg-light mb-2">@publicacion.Tipo</span>
                                <h3 class="h5 fw-bold mb-1">@publicacion.Nombre</h3>
                                <span class="badge text-bg-secondary">Eliminada</span>
                                @if (!string.IsNullOrWhiteSpace(publicacion.MotivoEliminacion))
                                {
                                    <p class="text-muted mb-0 mt-2">
                                        <strong>Motivo de eliminación:</strong> @publicacion.MotivoEliminacion
                                    </p>
                                }
                                @if (publicacion.ReactivacionSolicitada)
                                {
                                    <span class="badge text-bg-warning">Esperando respuesta del administrador</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</section>
