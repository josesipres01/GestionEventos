@model Proyecto
@{
    ViewData["Title"] = Model.Nombre;
    var estaRegistrado = ViewBag.EstaRegistrado as bool? ?? false;
    var puedeEditar = ViewBag.PuedeEditar as bool? ?? false;
    var registros = Model.Registros
        .OrderByDescending(r => r.FechaRegistro)
        .ToList();

    var autorNombre = Model.Usuario is not null
        ? string.Join(" ", new[] { Model.Usuario.Nombres, Model.Usuario.ApellidoPaterno, Model.Usuario.ApellidoMaterno }.Where(s => !string.IsNullOrWhiteSpace(s)))
        : Model.NombreResponsable;

    string[] imagenesProyectos =
    [
        "/img/proyecto-1.svg",
        "/img/proyecto-2.svg",
        "/img/proyecto-3.svg"
    ];
    var imagenPortada = !string.IsNullOrWhiteSpace(Model.ImagenUrl)
        ? Model.ImagenUrl
        : imagenesProyectos[Math.Abs(Model.IdProyecto) % imagenesProyectos.Length];

    static string ObtenerIniciales(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return "UN";
        }

        var partes = texto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}

<section class="nexo-section">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <a asp-controller="Proyectos" asp-action="Index" class="btn-nexo-outline">
            ← Volver a proyectos
        </a>
        <div class="d-flex align-items-center gap-2">
            @if (puedeEditar && Model.Activo)
            {
                <a asp-controller="Proyectos" asp-action="Editar" asp-route-id="@Model.IdProyecto" class="btn-nexo-outline">
                    ✎ Editar proyecto
                </a>
            }
            <a asp-controller="Eventos" asp-action="Index" class="nexo-link-underline small">
                Ir al explorador general
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="nexo-toast" role="status">
            <span class="nexo-toast-dot">✓</span>
            <span>@mensaje</span>
        </div>
    }

    @if (!Model.Activo)
    {
        <div class="alert alert-secondary" role="status">
            Este proyecto fue eliminado. Se conservaron sus datos y registros, pero ya no está disponible para nuevas inscripciones.
        </div>
    }

    <!-- Portada en grande del proyecto -->
    <header class="nexo-detail-hero">
        <img src="@imagenPortada" alt="@Model.Nombre" />
        <div class="nexo-detail-hero-overlay">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-light text-dark fw-bold px-3 py-2 text-uppercase" style="border-left: 4px solid var(--nexo-violet);">
                    PROYECTO ACADÉMICO
                </span>
                <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(215, 242, 90, 0.2); color: var(--nexo-lime);">
                    @(Model.Carrera?.Nombre ?? "Universidad de Sonora")
                </span>
            </div>

            <h1 class="nexo-detail-title">@Model.Nombre</h1>

            <div class="d-flex flex-wrap align-items-center gap-4 text-white-50 small">
                <span><strong>Responsable:</strong> <span class="text-white">@Model.NombreResponsable</span></span>
                <span><strong>Lugar de reunión:</strong> <span class="text-white">@Model.LugarReunion</span></span>
                <span><strong>Periodo:</strong> <span class="text-white">@Model.FechaInicio.ToString("dd MMM yyyy") – @Model.FechaFin.ToString("dd MMM yyyy")</span></span>
                <span><strong>Colaboradores inscritos:</strong> <span class="text-white">@registros.Count</span></span>
            </div>
        </div>
    </header>

    <div class="nexo-detail-grid">
        <!-- Columna principal: Descripción completa y lista de participantes -->
        <div class="d-flex flex-column gap-4">
            <article class="nexo-panel">
                <div class="nexo-eyebrow mb-2">
                    <span class="nexo-eyebrow-dot"></span>
                    <span>ACERCA DEL PROYECTO</span>
                </div>
                <h2 class="h4 fw-bold mb-3">Descripción e información detallada</h2>
                <div class="nexo-prose">@Model.Descripcion</div>
            </article>

            <!-- Lista de personas registradas en el proyecto -->
            <section class="nexo-panel" id="colaboradores">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3 pb-3 border-bottom">
                    <div>
                        <div class="nexo-eyebrow mb-1">
                            <span class="nexo-eyebrow-dot"></span>
                            <span>COMUNIDAD PARTICIPANTE</span>
                        </div>
                        <h2 class="h4 fw-bold mb-0">
                            Personas registradas en este proyecto (@registros.Count)
                        </h2>
                        <p class="text-muted small mb-0 mt-1">
                            Conoce a los estudiantes y miembros del campus que ya forman parte de esta iniciativa.
                        </p>
                    </div>

                    @if (registros.Any())
                    {
                        <div class="nexo-search-box" style="min-width: 230px;">
                            <span class="nexo-search-icon" aria-hidden="true">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </span>
                            <input type="search"
                                   class="nexo-search-input"
                                   placeholder="Buscar persona o carrera..."
                                   aria-label="Buscar entre las personas registradas"
                                   data-nexo-search />
                        </div>
                    }
                </div>

                @if (!registros.Any())
                {
                    <div class="nexo-empty py-4">
                        <p class="fw-semibold mb-1">Aún no hay colaboradores inscritos en este proyecto.</p>
                        <p class="text-muted small mb-0">¡Anímate a ser la primera persona en registrarte y colaborar!</p>
                    </div>
                }
                else
                {
                    <div class="nexo-attendee-list">
                        @foreach (var reg in registros)
                        {
                            var persona = reg.Usuario;
                            var nombrePersona = persona is not null
                                ? string.Join(" ", new[] { persona.Nombres, persona.ApellidoPaterno, persona.ApellidoMaterno }.Where(s => !string.IsNullOrWhiteSpace(s)))
                                : "Estudiante UNISON";
                            var carreraPersona = persona?.Carrera?.Nombre ?? "Comunidad UNISON";
                            var iniciales = ObtenerIniciales(nombrePersona);
                            var palabrasBusqueda = $"{nombrePersona} {carreraPersona}";

                            <div class="nexo-attendee-card"
                                 data-nexo-item
                                 data-nexo-type="todo"
                                 data-nexo-keywords="@palabrasBusqueda">
                                <span class="nexo-avatar-lg">@iniciales</span>
                                <div class="min-w-0">
                                    <div class="fw-bold text-truncate">@nombrePersona</div>
                                    <div class="text-muted small text-truncate">@carreraPersona</div>
                                    <div class="text-muted" style="font-size: 0.74rem;">
                                        Se unió el @reg.FechaRegistro.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="nexo-empty mt-3 py-3" data-nexo-empty-filter style="display: none;">
                        <p class="text-muted small mb-0">No se encontraron participantes con ese nombre o carrera.</p>
                    </div>
                }
            </section>
        </div>

        <!-- Columna lateral: Ficha técnica y registro al proyecto -->
        <aside class="nexo-panel">
            <div class="nexo-eyebrow mb-2">
                <span class="nexo-eyebrow-dot"></span>
                <span>FICHA DEL PROYECTO</span>
            </div>
            <h3 class="h5 fw-bold mb-3">Participa en esta iniciativa</h3>

            <dl class="mb-4">
                <dt class="text-muted small text-uppercase">Carrera o Departamento</dt>
                <dd class="fw-semibold mb-3">@(Model.Carrera?.Nombre ?? "General")</dd>

                <dt class="text-muted small text-uppercase">Responsable Académico (Organizador)</dt>
                <dd class="fw-semibold mb-3 d-flex align-items-center gap-2 mt-1">
                    <span class="nexo-avatar">@ObtenerIniciales(Model.NombreResponsable)</span>
                    <span>@Model.NombreResponsable</span>
                </dd>

                <dt class="text-muted small text-uppercase">Lugar de reunión</dt>
                <dd class="fw-semibold mb-3">@Model.LugarReunion</dd>

                <dt class="text-muted small text-uppercase">Fecha de inicio y fin</dt>
                <dd class="fw-semibold mb-3">@Model.FechaInicio.ToString("dd/MM/yyyy") al @Model.FechaFin.ToString("dd/MM/yyyy")</dd>

                <dt class="text-muted small text-uppercase">Autor de la publicación</dt>
                <dd class="fw-semibold mb-3">@autorNombre</dd>

                <dt class="text-muted small text-uppercase">Fecha de publicación</dt>
                <dd class="fw-semibold mb-3">@Model.FechaPublicacion.ToLocalTime().ToString("f")</dd>

                <dt class="text-muted small text-uppercase">Personas inscritas</dt>
                <dd class="fw-semibold mb-0">
                    @registros.Count @(registros.Count == 1 ? "colaborador registrado" : "colaboradores registrados")
                </dd>
            </dl>

            @if (Model.Activo && Model.EstadoAprobacion == EstadoAprobacion.Aprobado)
            {
                <div class="pt-3 border-top">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (estaRegistrado)
                        {
                            <div class="btn-nexo-registered w-100 justify-content-center py-2 mb-2">
                                <span>✓ Ya estás registrado en este proyecto</span>
                            </div>
                            <form asp-controller="Proyectos"
                                  asp-action="CancelarRegistro"
                                  asp-route-id="@Model.IdProyecto"
                                  method="post">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn-nexo-outline w-100 justify-content-center">
                                    Cancelar mi registro
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Proyectos"
                                  asp-action="RegistrarInteres"
                                  asp-route-id="@Model.IdProyecto"
                                  method="post">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn-nexo-primary w-100 justify-content-center py-2">
                                    <span>Registrarme en este proyecto</span>
                                    <span aria-hidden="true">→</span>
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <a asp-controller="Cuenta"
                           asp-action="IniciarSesion"
                           asp-route-returnUrl="@Context.Request.Path"
                           class="btn-nexo-primary w-100 justify-content-center py-2">
                            <span>Inicia sesión para registrarte</span>
                            <span aria-hidden="true">→</span>
                        </a>
                    }
                </div>
            }
        </aside>
    </div>

    @if (puedeEditar && Model.Activo)
    {
        <section class="nexo-panel mt-4">
            <h2 class="h5 fw-bold mb-2">Eliminar proyecto</h2>
            <p class="text-muted small">
                El proyecto se ocultará de la plataforma, pero sus datos y registros se conservarán. El creador recibirá este motivo.
            </p>
            <form asp-controller="Proyectos"
                  asp-action="Eliminar"
                  asp-route-id="@Model.IdProyecto"
                  method="post"
                  class="d-flex flex-column flex-sm-row align-items-sm-end gap-2">
                <div class="flex-grow-1">
                    <label for="motivoEliminacionProyecto" class="form-label">Motivo de eliminación</label>
                    <textarea id="motivoEliminacionProyecto"
                              name="motivo"
                              class="form-control"
                              maxlength="1000"
                              rows="2"
                              required></textarea>
                </div>
                <button type="submit" class="btn-nexo-ghost">Eliminar proyecto</button>
            </form>
        </section>
    }
</section>
