@model CrearProyectoViewModel
@{
    ViewData["Title"] = "Publicar proyecto";
}

<section class="nexo-form-shell">
    <div class="mb-4">
        <div class="nexo-eyebrow">
            <span class="nexo-eyebrow-dot"></span>
            <span>NUEVA INICIATIVA · PROYECTO ACADÉMICO</span>
        </div>
        <h1 class="nexo-section-title">Comparte tu proyecto con el campus</h1>
        <p class="text-muted mt-2 mb-0">
            Registra tu proyecto y selecciona al organizador responsable. El proyecto aparecerá en el campus cuando apruebe tu solicitud.
        </p>
    </div>

    <div class="nexo-panel">
        <form asp-action="Crear" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="nexo-label"></label>
                <input asp-for="Nombre" class="nexo-input" placeholder="Ej. Reverdece el campus / Sistema inteligente de monitoreo" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="nexo-label"></label>
                <textarea asp-for="Descripcion" class="nexo-textarea" rows="5" placeholder="Explica el objetivo del proyecto, su impacto en la universidad y cómo pueden colaborar otros estudiantes..."></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="IdUsuarioResponsable" class="nexo-label"></label>
                    <select asp-for="IdUsuarioResponsable" asp-items="ViewBag.Responsables" class="nexo-select">
                        <option value="">Selecciona un organizador responsable</option>
                    </select>
                    <span asp-validation-for="IdUsuarioResponsable" class="text-danger small"></span>
                    <div class="form-text text-muted small mt-1">
                        Solo pueden asignarse usuarios con rol Organizador.
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="IdCarrera" class="nexo-label"></label>
                    <select asp-for="IdCarrera" asp-items="ViewBag.Carreras" class="nexo-select">
                        <option value="">Selecciona una carrera o departamento</option>
                    </select>
                    <span asp-validation-for="IdCarrera" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="LugarReunion" class="nexo-label"></label>
                    <input asp-for="LugarReunion" class="nexo-input" placeholder="Ej. Laboratorio de Cómputo 3 / Sala de Juntas" />
                    <span asp-validation-for="LugarReunion" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaInicio" class="nexo-label"></label>
                    <input asp-for="FechaInicio" type="date" class="nexo-input" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaFin" class="nexo-label"></label>
                    <input asp-for="FechaFin" type="date" class="nexo-input" value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="FechaFin" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ImagenArchivo" class="nexo-label"></label>
                <input asp-for="ImagenArchivo"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp,.gif"
                       class="nexo-input"
                       id="inputImagenProyecto" />
                <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
                <div class="form-text text-muted small mt-1">
                    Formatos permitidos: JPG, PNG, WEBP o GIF (máx. 5 MB). Si no subes una imagen, se asignará una portada institucional por defecto.
                </div>

                <div id="contenedorPrevisualizacionProyecto" class="mt-3" style="display: none;">
                    <span class="text-muted small d-block mb-1 fw-semibold">Vista previa de la miniatura:</span>
                    <div class="nexo-card-media rounded-3 border" style="max-width: 360px; height: 200px;">
                        <span class="nexo-badge-type badge-proyecto">PROYECTO</span>
                        <img id="imgPrevisualizacionProyecto" src="" alt="Vista previa de miniatura" />
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-2">
                <button type="submit" class="btn-nexo-primary">
                    <span>Enviar solicitud</span>
                    <span aria-hidden="true">→</span>
                </button>
                <a asp-action="Index" class="btn-nexo-outline">Cancelar</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("inputImagenProyecto")?.addEventListener("change", function (e) {
            const archivo = e.target.files?.[0];
            const contenedor = document.getElementById("contenedorPrevisualizacionProyecto");
            const imagen = document.getElementById("imgPrevisualizacionProyecto");
            if (archivo && contenedor && imagen) {
                imagen.src = URL.createObjectURL(archivo);
                contenedor.style.display = "block";
            } else if (contenedor) {
                contenedor.style.display = "none";
            }
        });
    </script>
}
