@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Panel de Administración";

    static string ObtenerIniciales(string? nombres, string? paterno)
    {
        var n = !string.IsNullOrWhiteSpace(nombres) ? char.ToUpperInvariant(nombres.Trim()[0]).ToString() : "";
        var p = !string.IsNullOrWhiteSpace(paterno) ? char.ToUpperInvariant(paterno.Trim()[0]).ToString() : "";
        var res = n + p;
        return string.IsNullOrEmpty(res) ? "U" : res;
    }
}

<section class="nexo-section">
    <div class="mb-4">
        <div class="nexo-eyebrow">
            <span class="nexo-eyebrow-dot"></span>
            <span>ADMINISTRACIÓN GENERAL · UNISON</span>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 pb-3 border-bottom">
            <div>
                <h1 class="nexo-section-title">Panel de Control Administrativo</h1>
                <p class="text-muted mt-2 mb-0">
                    Gestiona cuentas de organizadores/docentes, permisos de usuarios, carreras universitarias y publicaciones del campus.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="RegistrarUsuario" class="btn-nexo-primary">
                    <span>+ Registrar Organizador / Usuario</span>
                </a>
                <a asp-action="Carreras" class="btn-nexo-outline">
                    Gestionar carreras (@Model.TotalCarreras)
                </a>
                <a asp-action="Publicaciones" class="btn-nexo-outline">
                    Supervisar eventos y proyectos
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="nexo-toast" role="status">
            <span class="nexo-toast-dot">✓</span>
            <span>@mensaje</span>
        </div>
    }

    <!-- Resumen de métricas -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="nexo-panel p-3 h-100">
                <div class="text-muted small text-uppercase fw-bold">Usuarios Totales</div>
                <div class="display-6 fw-bold mt-1" style="color: var(--nexo-forest);">@Model.TotalUsuarios</div>
                <div class="text-muted small mt-1">
                    @Model.TotalEstudiantes estudiantes · @Model.TotalAdministradores admin
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="nexo-panel p-3 h-100">
                <div class="text-muted small text-uppercase fw-bold">Organizadores / Docentes</div>
                <div class="display-6 fw-bold mt-1" style="color: var(--nexo-violet);">@Model.TotalOrganizadores</div>
                <div class="text-muted small mt-1">
                    Habilitados para eventos y proyectos
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="nexo-panel p-3 h-100">
                <div class="text-muted small text-uppercase fw-bold">Eventos Publicados</div>
                <div class="display-6 fw-bold mt-1" style="color: var(--nexo-teal);">@Model.TotalEventos</div>
                <div class="text-muted small mt-1">
                    @Model.TotalRegistrosEventos inscripciones activas
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="nexo-panel p-3 h-100">
                <div class="text-muted small text-uppercase fw-bold">Proyectos Académicos</div>
                <div class="display-6 fw-bold mt-1" style="color: var(--nexo-coral);">@Model.TotalProyectos</div>
                <div class="text-muted small mt-1">
                    En @Model.TotalCarreras carreras registradas
                </div>
            </div>
        </div>
    </div>

    <!-- Directorio y Gestión de Usuarios / Roles -->
    <div class="nexo-panel">
        <div class="nexo-catalog-header">
            <div>
                <h2 class="h4 fw-bold mb-1">Directorio de usuarios y asignación de roles</h2>
                <p class="text-muted small mb-0">
                    Aquí puedes promover usuarios existentes a <strong>Organizador/Docente</strong> o <strong>Administrador</strong>, o registrar nuevas cuentas.
                </p>
            </div>

            <div class="nexo-search-box">
                <span class="nexo-search-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input type="search"
                       class="nexo-search-input"
                       placeholder="Buscar por nombre, correo o rol..."
                       aria-label="Buscar usuarios"
                       data-nexo-search />
            </div>
        </div>

        <div class="nexo-filter-bar my-3">
            <div class="nexo-filter-pills" role="tablist">
                <button type="button" class="nexo-pill active" data-nexo-filter="todo">Todos (@Model.TotalUsuarios)</button>
                <button type="button" class="nexo-pill" data-nexo-filter="organizador">Organizadores (@Model.TotalOrganizadores)</button>
                <button type="button" class="nexo-pill" data-nexo-filter="administrador">Administradores (@Model.TotalAdministradores)</button>
                <button type="button" class="nexo-pill" data-nexo-filter="estudiante">Estudiantes (@Model.TotalEstudiantes)</button>
            </div>

            <div class="nexo-count-label"
                 data-nexo-counter
                 data-singular="usuario"
                 data-plural="usuarios">
                @Model.TotalUsuarios usuarios
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Carrera / Depto.</th>
                        <th>Estado</th>
                        <th>Rol asignado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        var nombreCompleto = string.Join(" ", new[] { usuario.Nombres, usuario.ApellidoPaterno, usuario.ApellidoMaterno }.Where(s => !string.IsNullOrWhiteSpace(s)));
                        var iniciales = ObtenerIniciales(usuario.Nombres, usuario.ApellidoPaterno);
                        var nombreRol = usuario.Rol?.Nombre ?? "Estudiante";
                        var tipoFiltro = nombreRol.Contains("Admin", StringComparison.OrdinalIgnoreCase)
                            ? "administrador"
                            : nombreRol.Contains("Organizador", StringComparison.OrdinalIgnoreCase)
                                ? "organizador"
                                : "estudiante";
                        var carreraNombre = usuario.Carrera?.Nombre ?? "Sin asignar";
                        var palabrasBusqueda = $"{nombreCompleto} {usuario.Correo} {nombreRol} {carreraNombre}";

                        <tr data-nexo-item
                            data-nexo-type="@tipoFiltro"
                            data-nexo-keywords="@palabrasBusqueda">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="nexo-avatar">@iniciales</span>
                                    <div>
                                        <div class="fw-bold">@nombreCompleto</div>
                                        <div class="text-muted" style="font-size: 0.76rem;">
                                            Alta: @usuario.FechaRegistro.ToLocalTime().ToString("dd MMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-muted">@usuario.Correo</td>
                            <td class="small">@carreraNombre</td>
                            <td>
                                @if (usuario.Activo)
                                {
                                    <span class="badge rounded-pill" style="background-color: var(--nexo-sage); color: var(--nexo-forest);">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td style="min-width: 220px;">
                                <form asp-action="CambiarRol" method="post" class="d-flex align-items-center gap-2 m-0">
                                    <input type="hidden" name="idUsuario" value="@usuario.IdUsuario" />
                                    <select name="idRol" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()" aria-label="Rol de @nombreCompleto">
                                        @foreach (var rol in Model.Roles)
                                        {
                                            <option value="@rol.IdRol" selected="@(rol.IdRol == usuario.IdRol)">
                                                @rol.Nombre
                                            </option>
                                        }
                                    </select>
                                </form>
                            </td>
                            <td class="text-end">
                                <form asp-action="CambiarEstadoUsuario" method="post" class="d-inline m-0">
                                    <input type="hidden" name="idUsuario" value="@usuario.IdUsuario" />
                                    <button type="submit" class="btn-nexo-ghost small">
                                        @(usuario.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="nexo-empty mt-3 py-3" data-nexo-empty-filter style="display: none;">
            <p class="text-muted small mb-0">No se encontraron usuarios con ese criterio.</p>
        </div>
    </div>
</section>

