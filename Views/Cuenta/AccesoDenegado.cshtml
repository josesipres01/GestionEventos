@{
    ViewData["Title"] = "Acceso denegado";
}

<section class="nexo-auth-shell">
    <div class="nexo-panel text-center">
        <div class="nexo-eyebrow justify-content-center">
            <span class="nexo-eyebrow-dot"></span>
            <span>PERMISOS REQUERIDOS</span>
        </div>
        <h1 class="h3 fw-bold mb-3">Acceso restringido</h1>
        <p class="text-muted mb-4">
            No cuentas con los permisos necesarios para acceder a esta sección. Esta acción está reservada para perfiles de Organizador o Administrador.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Eventos" asp-action="Index" class="btn-nexo-primary">Volver a Explorar</a>
            <a asp-controller="Proyectos" asp-action="Index" class="btn-nexo-outline">Ver proyectos</a>
        </div>
    </div>
</section>
