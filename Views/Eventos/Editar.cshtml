@model EditarEventoViewModel
@{
    ViewData["Title"] = "Editar evento";
}

<section class="nexo-form-shell">
    <div class="mb-4">
        <div class="nexo-eyebrow">
            <span class="nexo-eyebrow-dot"></span>
            <span>GESTIÓN DE EVENTOS · ORGANIZADOR</span>
        </div>
        <h1 class="nexo-section-title">Editar información del evento</h1>
        <p class="text-muted mt-2 mb-0">
            Actualiza los detalles, fecha, hora, ubicación o miniatura de este evento universitario.
        </p>
    </div>

    <div class="nexo-panel">
        <form asp-action="Editar" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="IdEvento" />
            <input type="hidden" asp-for="ImagenUrlActual" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="nexo-label"></label>
                <input asp-for="Nombre" class="nexo-input" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="nexo-label"></label>
                <textarea asp-for="Descripcion" class="nexo-textarea" rows="4"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FechaHora" class="nexo-label"></label>
                    <input asp-for="FechaHora" type="datetime-local" class="nexo-input" value="@Model.FechaHora.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="FechaHora" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaFin" class="nexo-label"></label>
                    <input asp-for="FechaFin" type="datetime-local" class="nexo-input" value="@Model.FechaFin.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="FechaFin" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Lugar" class="nexo-label"></label>
                    <input asp-for="Lugar" class="nexo-input" />
                    <span asp-validation-for="Lugar" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Cupo" class="nexo-label"></label>
                    <input asp-for="Cupo" type="number" min="1" class="nexo-input" placeholder="Sin límite" />
                    <span asp-validation-for="Cupo" class="text-danger small"></span>
                    <div class="form-text text-muted small mt-1">Déjalo vacío si no hay límite de asistencia.</div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ImagenArchivo" class="nexo-label"></label>
                <input asp-for="ImagenArchivo"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp,.gif"
                       class="nexo-input"
                       id="inputImagenEventoEditar" />
                <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
                <div class="form-text text-muted small mt-1">
                    Selecciona una nueva imagen (JPG, PNG, WEBP o GIF, máx. 5 MB) solo si deseas reemplazar la miniatura actual.
                </div>

                <div id="contenedorMiniaturaActual" class="mt-3" style="@(string.IsNullOrWhiteSpace(Model.ImagenUrlActual) ? "display: none;" : "")">
                    <span class="text-muted small d-block mb-1 fw-semibold">Miniatura del evento:</span>
                    <div class="nexo-card-media rounded-3 border" style="max-width: 360px; height: 200px;">
                        <span class="nexo-badge-type">EVENTO</span>
                        <img id="imgPrevisualizacionEditar" src="@(Model.ImagenUrlActual ?? "")" alt="Miniatura del evento" />
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-2">
                <button type="submit" class="btn-nexo-primary">
                    <span>Guardar cambios</span>
                    <span aria-hidden="true">→</span>
                </button>
                <a asp-action="MisEventos" class="btn-nexo-outline">Cancelar</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("inputImagenEventoEditar")?.addEventListener("change", function (e) {
            const archivo = e.target.files?.[0];
            const contenedor = document.getElementById("contenedorMiniaturaActual");
            const imagen = document.getElementById("imgPrevisualizacionEditar");
            if (archivo && contenedor && imagen) {
                imagen.src = URL.createObjectURL(archivo);
                contenedor.style.display = "block";
            }
        });
    </script>
}
